# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role : SERVEUR UNIQUEMENT (ne jamais préfixer par NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://zone-groupe.vercel.app

# --- Paiement mobile money (nyole) ---
# nyole = vrai paiement | mock = simulation locale (développement uniquement)
PAYMENT_PROVIDER=nyole
# Clé secrète nyole : af_test_sec_... (test) ou af_live_sec_... (réel). SERVEUR UNIQUEMENT.
NYOLE_SECRET_KEY=
